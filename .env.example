# Runtime environment
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# Jaeger OTLP HTTP exporter
JAEGER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_SERVICE_NAMESPACE=distributed-agency

# LLM_PROVIDER accepts mock, openai, or ollama.
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=60

# Only needed for LLM_PROVIDER=openai. Keep the real value in .env.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Only needed for LLM_PROVIDER=ollama.
OLLAMA_API_BASE=http://host.docker.internal:11434

# Gateway request timeout for the worker loop.
PROJECT_TIMEOUT_SECONDS=90